PORT=3000
MONGO_URI=mongodb://localhost:27017/ca_v4
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d
FIRM_NAME="AVKAS & Co."
SITE_URL=http://localhost:3000

# Partner / Admin login. Created automatically when the server starts.
# "npm run seed" resets its password to the value below.
ADMIN_NAME="Heet Shah"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# AWS (one IAM user with SES send-email and S3 put/get object permissions)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email through AWS SES
SES_FROM=no-reply@yourdomain.com
MAIL_TO=office@yourdomain.com

# Resume storage in AWS S3 (private bucket). Leave empty to store files locally while testing.
S3_BUCKET=
